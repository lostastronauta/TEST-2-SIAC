<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Denuncia - Paso 4 - Ingresar datos establecimiento</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="../css/site.css">
</head>
<body>
    <div id="header-container"></div>
    <main class="container">
        <div class="stepper">
            <div class="step-item"><div class="step-circle">1</div><div class="step-label">Relato</div></div>
            <div class="step-item"><div class="step-circle">2</div><div class="step-label">Identificación</div></div>
            <div class="step-item"><div class="step-circle">3</div><div class="step-label">Afectado</div></div>
            <div class="step-item active"><div class="step-circle">4</div><div class="step-label">Establecimiento</div></div>
            <div class="step-item"><div class="step-circle">5</div><div class="step-label">Confirmación</div></div>
        </div>

        <h2>Paso 4: Datos del establecimiento</h2>
        <p>Identifica el establecimiento relacionado con la denuncia.</p>

        <form id="formPaso4" novalidate>
            <div class="form-group">
                <label for="establecimiento">Nombre del establecimiento <span style="color:#b32">*</span></label>
                <input id="establecimiento" name="establecimiento" class="form-control" style="width:100%;padding:10px;border:1px solid #ddd;border-radius:6px" placeholder="Ej: Escuela ABC" required>
                <div class="field-error" id="errEstablecimiento">Este campo es obligatorio.</div>
            </div>

            <div class="actions">
                <a href="denuncia-paso3.html" class="btn btn-secondary">Volver</a>
                <button class="btn btn-primary" id="btnSiguiente4" type="submit">Siguiente</button>
            </div>
        </form>
    </main>

    <script>
        var saved = sessionStorage.getItem('denunciaPaso4');
        if (saved) { try { var obj = JSON.parse(saved); if (obj.establecimiento) document.getElementById('establecimiento').value = obj.establecimiento; } catch(e){} }

        var __el = document.getElementById(''); if (__el) __el.addEventListener('submit', function(e){
            e.preventDefault();
            var establecimiento = document.getElementById('establecimiento').value.trim();
            var err = document.getElementById('errEstablecimiento');
            if (!establecimiento) { err.classList.add('visible'); document.getElementById('establecimiento').focus(); return; }
            if (err) err.classList.remove('visible');
            sessionStorage.setItem('denunciaPaso4', JSON.stringify({ establecimiento: establecimiento }));
            window.location.href = 'denuncia-paso5.html';
        });
    </script>

    <div id="footer-container"></div>
    <script src="../js/components.js" defer></script>
</body>
</html>